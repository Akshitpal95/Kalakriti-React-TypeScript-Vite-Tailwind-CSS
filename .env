# Server Configuration
PORT=5000
NODE_ENV=development

# 0. Google Gemini AI (Multimodal Vision & Fast Cataloging)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 1. Indian Multilingual Speech & Translation (Bhashini ULCA / NLTM)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# 2. OpenAI (Whisper STT & GPT-4o Vision / JSON Structuring)
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=

# 3. Microsoft Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# 4. Google Cloud Speech-to-Text
GOOGLE_SPEECH_API_KEY=

# 5. Payments (Razorpay & Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
