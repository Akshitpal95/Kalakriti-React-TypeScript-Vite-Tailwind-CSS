# ==============================================================================
# The Anti-Gravity Talent Hub — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# 1. Indian Multilingual Speech & Translation (Bhashini ULCA / NLTM)
BHASHINI_API_KEY=your_bhashini_inference_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# 2. OpenAI (Whisper STT & GPT-4o Vision / JSON Structuring)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# 3. Microsoft Azure AI Speech (Speech Translation: Hindi Speech -> English Text)
AZURE_SPEECH_KEY=your_azure_speech_subscription_key_here
AZURE_SPEECH_REGION=centralindia

# 4. Google Cloud Speech-to-Text
GOOGLE_SPEECH_API_KEY=your_google_cloud_speech_api_key_here

# 5. Payments & Direct Payouts (Razorpay & Stripe)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# 6. Marketplace Sync (Etsy, ONDC, Shopify, WooCommerce)
ETSY_KEYSTRING=your_etsy_v3_keystring
ETSY_SHARED_SECRET=your_etsy_shared_secret
ONDC_SUBSCRIBER_ID=talent-hub.ondc.org
ONDC_SIGNING_PRIVATE_KEY=your_ondc_ed25519_private_key
SHOPIFY_STORE_URL=your-artisan-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_access_token
WOOCOMMERCE_STORE_URL=https://your-craft-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# 7. Database & Object Storage (Optional for persistent cloud hosting)
DATABASE_URL=postgresql://postgres:password@localhost:5432/talent_hub
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_S3_BUCKET=talent-hub-artisan-media
AWS_REGION=ap-south-1
